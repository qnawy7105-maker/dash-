rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // For this implementation, we allow all signed-in users as admins for the dashboard demo
      // In production, we would check a specific custom claim or an admins collection
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        request.auth.token.email.matches('.*@gmail\\.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Quiz Config
    match /quiz/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Sections
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
    }

    // Admin list
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via console or service account
    }
  }
}
